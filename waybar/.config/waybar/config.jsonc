{
  "position": "top",

  // "margin-top": 10,
  // "margin-bottom": 5,
  // "margin-left": 5,
  // "margin-right": 5,

  "modules-left": [
    "ext/workspaces",
    "hyprland/window"
  ],

  "modules-right": [
    "tray",
    "hyprland/language",
    "custom/nvidia",
    "cpu",
    "memory",
    "pulseaudio",
    "backlight",
    "power-profiles-daemon",
    "battery",
    "network",
    "clock"
  ],

  "ext/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
  },

  "hyprland/window": {
    "format": " > {initialTitle}",
  },

  "tray": {
    "icon-size": 10,
    "show-passive-items": true,
    "justify-center": true
  },

  "hyprland/language": {
    "format": " {} ",
    "format-en": "us",
    "format-ru": "ru",
    "format-pl": "pl",
  },

  "cpu": {
    "interval": 2,
    "format": " cpu {usage}% ",
  },

  "memory": {
    "interval": 30,
    "format": " ram {used:0.1f}g ",
    "tooltip": true,
    "tooltip-format": "ram: {used:0.1f} / {total:0.1f}g"
  },

  "battery": {
    "format": " bat {capacity}% ",
  },

  "network": {
    "format-wifi": " wifi ",
    "format-ethernet": " eth ",
    "format-disconnected": " disc ",
  },

  "pulseaudio": {
    "format": " vol {volume}% ",
  },

  "backlight": {
    "format": " brt {percent}% ",
  },

  "clock": {
    "interval": 60,
    "format": "{:%m.%d.%y %I:%M %p}",
    "tooltip": true,
    "tooltip-format": "{:%A, %B %d %Y}"
  },

  "power-profiles-daemon": {
    "format": "pwr: {icon}",
    "tooltip": false,
    "format-icons": {
      "performance": "per",
      "balanced": "bal",
      "power-saver": "sav"
    }
  },

  "custom/nvidia": {
      "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,nounits,noheader | sed 's/\\([0-9]\\+\\), \\([0-9]\\+\\)/\\1% 🌡️\\2°C/g'",
      "format": "  gpu {}%",
      "interval": 2
  }

}
